  "fixtureCoverage": {
    "agent-sdk": "frozen queue entry through qualified capture, approved export, normalization, configurable judging, review, aggregation, and Atlas",
    "openhands-agent-server": "pinned REST/WebSocket stream-final reconciliation, workspace/outcome evidence, partial capture, and retained evaluation; EBO-started in-environment Agent Server with a version-gated readiness check and an environment-resolved conversation credential",
    "deepseek-harness": "official-client JSON-RPC composition, receipt-to-idle completion under a resettable inactivity window, stderr, interruption, shutdown, swaps, and retained evaluation",
    "codex-app-server": "owned stdio lifecycle, full history, OTLP, interruption/failure, export, and retained evaluation; configurable workspace-write networking with explicit offline queue propagation; third-party Responses provider routes with a declared provider config, recorded launch arguments, and an isolated provider credential",
    "acceptance-cases": "seeded ordering, context-classified secret redaction and scanning, partial attempts, native references, abstention, disputes, denominators, and unsupported comparisons",
    "pi-sdk": "frozen queue, passive hooks, durable session, partial cleanup, export, retained normalization and evaluation",
    "cursor-sdk": "frozen queue, official store, callbacks/history, bounded cancellation, export, retained normalization and evaluation; HTTP/1.1 configuration ordering, native retry validation, terminal transport error retention without replacement; cumulative usage finalization on success, failure, interruption, unavailable counters and getter failure",
    "workspace-capture": "Git state and unsafe entries omitted with explicit gaps; verified patch/snapshot; real Cursor workspace repackaged",
    "harbor": "Harbor 0.22 admission and Smol 1.18.2 bundled-libkrun provenance, direct and separate-process branching, local preparation, no-model live Trial capture and cleanup",
    "behavioralEvaluation": "Sequential judge batches, interruption, model-only populations, optional review and bounded large relations; occurrence ratings with retained decision records and judge requests with a complete occurrence ledger and recorded frame",
    "provider-routes": "sanitized Codex, Pi, and DeepSeek third-party provider route records and a Responses normalization example",
    "devin-cli": "owned `devin acp` stdio lifecycle with every ACP frame retained, OTLP/HTTP protobuf receipt, interruption and finalization, retained normalization"
  },
  "determinism": {
    "stable": [
      "task, run, attempt, event, assertion, aggregate, and Atlas case identities",
      "fixture, native-reference, normalized-dataset, source/cohort, archive, and package digests",
      "seeded queue and review-sample ordering"
    ],
    "excluded": [
      "native and EBO observation timestamps",
      "lifecycle start/finish timestamps",
      "provider timing and usage",
      "temporary workspace and output paths"
    ]
  },
