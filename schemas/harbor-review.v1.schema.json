{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ebo.dev/schemas/harbor-review.v1.schema.json",
  "title": "EBO Harbor human review record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "taskSourceId", "preAdmissionDigest", "decision", "reviewedAt", "reviewedBy"],
  "properties": {
    "schemaVersion": { "const": "ebo.harbor-review/v1" },
    "taskSourceId": { "type": "string", "pattern": "^harbor-[0-9a-f]{16}$" },
    "preAdmissionDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "decision": { "enum": ["admitted", "rejected"] },
    "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}" },
    "reviewedBy": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" }
  }
}
