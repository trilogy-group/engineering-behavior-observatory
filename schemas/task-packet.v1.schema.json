{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ebo.dev/schemas/task-packet.v1.schema.json",
  "title": "EBO task packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "agentInput",
    "provenance",
    "controlledPerturbation",
    "sharing",
    "admission",
    "components",
    "restricted"
  ],
  "properties": {
    "schemaVersion": { "const": "ebo.task-packet/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "agentInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "fixture"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1 },
        "fixture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "materializer"],
          "properties": {
            "source": { "$ref": "#/$defs/safeSource" },
            "materializer": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "destination", "includePaths"],
              "properties": {
                "kind": { "const": "verified-archive" },
                "destination": { "const": "workspace" },
                "includePaths": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryUrl", "revision", "license"],
      "properties": {
        "repositoryUrl": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "controlledPerturbation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "summary", "digest"],
      "properties": {
        "kind": {
          "enum": ["contract-change", "seeded-defect", "long-horizon-constraint"]
        },
        "summary": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "sharing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification"],
      "properties": {
        "classification": { "enum": ["open", "restricted", "internal"] }
      }
    },
    "admission": { "$ref": "#/$defs/admission" },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentInput"],
      "properties": {
        "agentInput": { "$ref": "#/$defs/digest" }
      }
    },
    "restricted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referenceSolution", "verifier", "reviewRecord"],
      "properties": {
        "referenceSolution": { "$ref": "#/$defs/restrictedReference" },
        "verifier": { "$ref": "#/$defs/restrictedReference" },
        "reviewRecord": { "$ref": "#/$defs/restrictedReference" }
      }
    }
  },
  "$defs": {
    "admission": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "review"],
          "properties": {
            "status": { "const": "proposed" },
            "review": { "const": null }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "review"],
          "properties": {
            "status": { "enum": ["admitted", "rejected"] },
            "review": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reviewedAt", "reviewedBy"],
              "properties": {
                "reviewedAt": { "type": "string", "format": "date-time" },
                "reviewedBy": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      ]
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "safeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator", "digest"],
      "properties": {
        "kind": { "const": "sanitized-archive" },
        "locator": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "restrictedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "digest"],
      "properties": {
        "locator": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
