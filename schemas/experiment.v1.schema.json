{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ebo.dev/schemas/experiment.v1.schema.json",
  "title": "EBO experiment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "taskSet",
    "modelSet",
    "harnessSet",
    "trialCount",
    "ordering",
    "coordinatorBudget",
    "toolPolicy",
    "captureProfile"
  ],
  "properties": {
    "schemaVersion": { "const": "ebo.experiment/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "taskSet": { "$ref": "#/$defs/conditionSet" },
    "modelSet": { "$ref": "#/$defs/conditionSet" },
    "harnessSet": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/harnessCondition" }
    },
    "trialCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "strategy"],
      "properties": {
        "seed": { "type": "string", "minLength": 1 },
        "strategy": { "enum": ["declared", "permuted"] }
      }
    },
    "coordinatorBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxWallClockMs"],
      "properties": {
        "maxWallClockMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "toolPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "tools"],
      "properties": {
        "mode": { "enum": ["allowlist", "denylist"] },
        "tools": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "captureProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contentCapture"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "contentCapture": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "configurationReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "digest"],
      "properties": {
        "locator": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configurationRef"],
      "properties": {
        "configurationRef": { "$ref": "#/$defs/configurationReference" }
      }
    },
    "conditionSet": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/condition" }
    },
    "harnessCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configurationRef", "nativeLimitsRef"],
      "properties": {
        "configurationRef": { "$ref": "#/$defs/configurationReference" },
        "nativeLimitsRef": { "$ref": "#/$defs/configurationReference" }
      }
    }
  }
}
