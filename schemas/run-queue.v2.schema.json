{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ebo.dev/schemas/run-queue.v2.schema.json",
  "title": "EBO run queue v2 (Harbor-backed)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "experimentId",
    "experimentDigest",
    "schedulingDigest",
    "captureProfile",
    "coordinatorBudget",
    "execution",
    "matrix",
    "seed",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ebo.run-queue/v2"
    },
    "experimentId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "experimentDigest": {
      "$ref": "#/$defs/digest"
    },
    "schedulingDigest": {
      "$ref": "#/$defs/digest"
    },
    "captureProfile": {
      "$ref": "#/$defs/reference"
    },
    "coordinatorBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxWallClockMs"
      ],
      "properties": {
        "maxWallClockMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environmentProfile",
        "contextPolicy"
      ],
      "properties": {
        "environmentProfile": {
          "enum": [
            "docker",
            "local-fs-test"
          ]
        },
        "contextPolicy": {
          "const": "fresh"
        },
        "workerRef": {
          "$ref": "#/$defs/reference"
        }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskIds",
        "modelIds",
        "harnessIds",
        "trialCount"
      ],
      "properties": {
        "taskIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "modelIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "harnessIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "trialCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "seed": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "taskId",
        "modelId",
        "harnessId",
        "trialIndex",
        "task",
        "model",
        "harness",
        "configuration",
        "trial"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "pattern": "^run-[0-9a-f]{64}$"
        },
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "modelId": {
          "type": "string",
          "minLength": 1
        },
        "harnessId": {
          "type": "string",
          "minLength": 1
        },
        "trialIndex": {
          "type": "integer",
          "minimum": 1
        },
        "task": {
          "$ref": "#/$defs/frozenTask"
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "configurationRef"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "configurationRef": {
              "$ref": "#/$defs/reference"
            }
          }
        },
        "harness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "configurationRef",
            "nativeLimitsRef",
            "nativeToolPolicyRef"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "configurationRef": {
              "$ref": "#/$defs/reference"
            },
            "nativeLimitsRef": {
              "$ref": "#/$defs/reference"
            },
            "nativeToolPolicyRef": {
              "$ref": "#/$defs/reference"
            }
          }
        },
        "configuration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "harness",
            "nativeLimits",
            "nativeToolPolicy"
          ],
          "properties": {
            "model": {
              "$ref": "#/$defs/reference"
            },
            "harness": {
              "$ref": "#/$defs/reference"
            },
            "nativeLimits": {
              "$ref": "#/$defs/reference"
            },
            "nativeToolPolicy": {
              "$ref": "#/$defs/reference"
            }
          }
        },
        "trial": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "index"
          ],
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "frozenTask": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "taskSourceId",
            "harborDigest",
            "assessmentMode",
            "snapshotLocator",
            "admissionLocator",
            "admissionDigest",
            "freezeLocator",
            "freezeDigest",
            "resolutionDigest"
          ],
          "properties": {
            "kind": {
              "const": "harbor-task"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "taskSourceId": {
              "type": "string",
              "pattern": "^harbor-[0-9a-f]{16}$"
            },
            "harborDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "assessmentMode": {
              "enum": [
                "observational",
                "verified"
              ]
            },
            "snapshotLocator": {
              "type": "string",
              "minLength": 1
            },
            "admissionLocator": {
              "type": "string",
              "minLength": 1
            },
            "admissionDigest": {
              "$ref": "#/$defs/digest"
            },
            "freezeLocator": {
              "type": "string",
              "minLength": 1
            },
            "freezeDigest": {
              "$ref": "#/$defs/digest"
            },
            "resolutionDigest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "packetId",
            "packetRef",
            "freezeLocator",
            "aggregateDigest"
          ],
          "properties": {
            "kind": {
              "const": "legacy-task-packet"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "packetId": {
              "type": "string",
              "minLength": 1
            },
            "packetRef": {
              "$ref": "#/$defs/reference"
            },
            "freezeLocator": {
              "type": "string",
              "minLength": 1
            },
            "aggregateDigest": {
              "$ref": "#/$defs/digest"
            }
          }
        }
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locator",
        "digest"
      ],
      "properties": {
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
