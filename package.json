{
  "name": "engineering-behavior-observatory",
  "version": "0.1.0",
  "private": true,
  "description": "Native engineering-agent evidence capture and observation.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "ebo": "./dist/src/cli.js"
  },
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "acceptance": "node scripts/release-acceptance.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "ebo": "node dist/src/cli.js"
  },
  "files": [
    "contracts/",
    "dist/contracts/",
    "dist/src/",
    "docs/",
    "ontology/",
    "release/0.1.0/",
    "schemas/",
    "scripts/atlas-grafana.sh"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.258",
    "@deepseek-ai/dsh-sdk-client": "0.1.1-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.1-rc.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "^5.9.3"
  }
}
